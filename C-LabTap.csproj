<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>C_LabTap</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- "Sign in with Google" (see AccountController.GoogleLogin/GoogleResponse).
         If `dotnet restore` can't find this exact version, run
         `dotnet add package Microsoft.AspNetCore.Authentication.Google`
         yourself - it'll pick whatever version actually matches net10.0. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
  </ItemGroup>

</Project>
