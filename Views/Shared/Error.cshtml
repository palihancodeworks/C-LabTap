@model ErrorViewModel
@inject C_LabTap.Services.SupabaseService Supabase
@{
    ViewData["Title"] = "Something went wrong";
    // Standalone, same shell as the login page (login.css) so a crash
    // still looks like C-LabTap and not the stock ASP.NET template with
    // its "Home / Privacy" navbar. Layout = null on purpose: this used
    // to inherit _ViewStart's "_Layout" (the scaffolded one).
    Layout = null;

    // Branding is fetched from Supabase - if Supabase itself is what
    // failed, this page must still render, so fall back to the bundled
    // defaults rather than throwing a second time inside the error page.
    string brandLogoUrl = C_LabTap.Models.BrandingHelper.DefaultLogoUrl;
    string brandBgUrl = C_LabTap.Models.BrandingHelper.DefaultBackgroundUrl;
    try
    {
        brandLogoUrl = await C_LabTap.Models.BrandingHelper.GetLogoUrlAsync(Supabase);
        brandBgUrl = await C_LabTap.Models.BrandingHelper.GetBackgroundUrlAsync(Supabase);
    }
    catch { /* keep defaults */ }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - C-LABTAP</title>
    <link rel="icon" type="image/x-icon" href="~/C-LabTap.icon.ico" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,700;1,400&family=Public+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-body" style="background: linear-gradient(rgba(10, 26, 20, 0.5), rgba(10, 26, 20, 0.5)), url('@brandBgUrl') center / cover no-repeat;">
    <div class="login-card">
        <div class="login-left">
            <div class="login-brand-row">
                <img src="@Url.Content(brandLogoUrl)" alt="AAMNHS logo" class="login-logo" />
                <div class="login-brand-text">
                    <span class="login-brand-line">C-LABTAP</span>
                    <span class="login-brand-line">COMPUTER LABORATORY LOGBOOK</span>
                </div>
            </div>
            <h1 class="login-school-name">Aurelio Arago Memorial National High School</h1>
            <p class="login-tagline">Junior High School Computer Laboratory RFID-based entry, exit and equipment borrowing records</p>
        </div>

        <div class="login-right">
            <h2 class="login-title">Something went wrong</h2>
            <p class="login-subtitle">C-LabTap hit a problem while loading that page. Nothing you entered was lost on our side - go back and try again.</p>

            <div class="login-form">
                <a class="login-btn" asp-controller="Account" asp-action="Index">Back to login</a>
            </div>

            <div class="login-divider"><span>or</span></div>

            <a class="login-btn-google" asp-controller="Logbook" asp-action="Index">Open the kiosk</a>

            @if (Model?.ShowRequestId == true)
            {
                <p class="login-footer">If this keeps happening, tell the admin this code: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</body>
</html>
