@{
    Layout = null;
}
<div class="stat-filter-row">
    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card-title">Items Registered</div>
            <div class="stat-card-row">
                <svg class="stat-card-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M7 12h10M12 7v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                <span class="stat-card-value" id="statTotalRegistered">&mdash;</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-title">Currently Borrowed</div>
            <div class="stat-card-row">
                <svg class="stat-card-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3L4 7.5V16.5L12 21L20 16.5V7.5L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M4 7.5L12 12L20 7.5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M12 12V21" stroke="currentColor" stroke-width="1.8"/>
                </svg>
                <span class="stat-card-value" id="statBorrowed">&mdash;</span>
            </div>
        </div>
    </div>
    <!-- Shared filter bar (same layout/component as Register Student, Attendance,
         Item Lending - see admin.js CLabTapFilterBar). -->
    <div class="filter-bar filter-bar--stacked fbar" id="itemFbar">
        <div class="fbar-top">
            <div class="search-combo">
                <input type="text" placeholder="Search item name or code" id="itemFilterSearch" autocomplete="off" />
            </div>
            <div class="fbar-more-wrap">
                <button type="button" class="fbar-more" id="itemFbarMore" aria-expanded="false" aria-controls="itemFbarPanel">
                    <svg class="fbar-more-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16l-6 7.5V19l-4-2v-4.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    <span>Filters</span>
                    <span class="fbar-badge" id="itemFbarBadge" hidden>0</span>
                </button>
                <div class="fbar-panel" id="itemFbarPanel" role="group" aria-label="More filters" hidden>
                    <div class="fbar-panel-grid">
                        <div class="filter-field item-date-filter">
                            <label>Date Start</label>
                            <div class="date-filter-input">
                                <span class="date-filter-placeholder" aria-hidden="true">Choose date</span>
                                <input type="date" id="itemFilterDateStart" />
                            </div>
                        </div>
                        <div class="filter-field item-date-filter">
                            <label>Date End</label>
                            <div class="date-filter-input">
                                <span class="date-filter-placeholder" aria-hidden="true">Choose date</span>
                                <input type="date" id="itemFilterDateEnd" />
                            </div>
                        </div>
                        <div class="filter-field item-product-filter">
                            <label for="itemFilterProduct">Product</label>
                            <select id="itemFilterProduct">
                                <option value="">All</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" class="fbar-reset" id="itemFilterClear" aria-label="Clear all filters" title="Clear all filters"><img src="@Url.Content("~/images/icons/clear.icon.png")" alt="" class="fbar-reset-icon" /><span class="fbar-reset-label">Clear</span></button>
        </div>
        <div class="fbar-quick">
            <div class="filter-field fbar-seg">
                <label>Category</label>
                <div class="toggle-group toggle-group--sliding" id="itemFilterCategory" data-value="All">
                    <span class="toggle-slider"></span>
                    <button type="button" class="toggle-option active" data-value="All">All</button>
                    <button type="button" class="toggle-option" data-value="Lab Equipment">Lab Equipment</button>
                    <button type="button" class="toggle-option" data-value="Peripheral">Peripheral</button>
                </div>
            </div>
            <div class="filter-field fbar-seg">
                <label>Status</label>
                <div class="toggle-group toggle-group--sliding" id="itemFilterStatus" data-value="All">
                    <span class="toggle-slider"></span>
                    <button type="button" class="toggle-option active" data-value="All">All</button>
                    <button type="button" class="toggle-option" data-value="Available">Available</button>
                    <button type="button" class="toggle-option" data-value="Borrowed">Borrowed</button>
                </div>
            </div>
            <button type="button" class="btn-apply" id="itemFilterApply">Apply filters</button>
        </div>
        <div class="fbar-foot">
            <div class="fbar-chips fbar-chips--slot" id="itemFbarChips" aria-label="Applied filters"></div>
        </div>
    </div>
</div>

<div class="reg-overlay" id="itemOverlay" style="display:none;">
<div class="regf-card regf-card--compact" role="dialog" aria-modal="true" aria-labelledby="itemFormTitle">
    <div class="regf-header">
        <div class="regf-head-main regf-head-title-row">
            <span class="regf-head-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M7 12h10M12 7v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
            </span>
            <h2 class="regf-title" id="itemFormTitle">Register Item</h2>
        </div>
        <button type="button" class="regf-close" id="itemOverlayClose" aria-label="Close form" title="Close (Esc)">&times;</button>
    </div>

    <form class="regf-body" id="itemForm" novalidate autocomplete="off">
        <div class="regf-message" id="itemFormMsg" role="alert" aria-live="assertive" hidden></div>

        <div class="regf-row">
            <div class="regf-field regf-grow">
                <label for="itemName">Item Name <span class="regf-req" aria-hidden="true">*</span></label>
                <input type="text" class="regf-input" id="itemName" maxlength="60" required />
            </div>
            <div class="regf-field regf-half">
                <label for="itemCode" id="itemCodeLabel">Item Code <span class="regf-req" aria-hidden="true">*</span></label>
                <input type="text" class="regf-input" id="itemCode" maxlength="20" required />
            </div>
        </div>

        <div class="regf-row">
            <div class="regf-field regf-category">
                <span class="regf-label" id="itemCategoryLabel">Category</span>
                <div class="regf-chips" id="itemCategoryChips" role="radiogroup" aria-labelledby="itemCategoryLabel">
                    <button type="button" class="regf-chip" role="radio" aria-checked="false" data-value="Lab Equipment">Lab Equipment</button>
                    <button type="button" class="regf-chip" role="radio" aria-checked="false" data-value="Peripheral">Peripheral</button>
                </div>
                <select class="regf-sr-only" id="itemCategory" tabindex="-1" aria-hidden="true">
                    <option value="">Select category</option>
                    <option>Lab Equipment</option>
                    <option>Peripheral</option>
                </select>
            </div>
            <div class="regf-field regf-half" id="itemQtyField">
                <label for="itemQty">Quantity</label>
                <input type="number" class="regf-input" id="itemQty" min="1" step="1" />
                <p class="regf-help" id="itemFormHint">Adds 01, 02... per unit.</p>
            </div>
        </div>

        <div class="regf-actions">
            <p class="regf-submit-hint" aria-live="polite"></p>
            <button type="button" class="regf-btn regf-btn-outline" id="registerItemClearBtn">Clear</button>
            <button type="button" class="regf-btn regf-btn-primary" id="registerItemSubmitBtn">Register Item</button>
        </div>
    </form>
</div>
</div>

<div class="regf-confirm regf-confirm--fixed" id="itemDeleteConfirm" role="alertdialog" aria-modal="true" aria-labelledby="itemDeleteConfirmTitle" aria-describedby="itemDeleteConfirmText" hidden>
    <div class="regf-confirm-box">
        <div class="regf-confirm-icon regf-confirm-icon--danger" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m2 0-1 13a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 7h12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3 class="regf-confirm-title" id="itemDeleteConfirmTitle">Delete item?</h3>
        <p class="regf-confirm-text" id="itemDeleteConfirmText"></p>
        <div class="regf-confirm-actions">
            <button type="button" class="regf-btn regf-btn-outline" id="itemDeleteConfirmCancel">Cancel</button>
            <button type="button" class="regf-btn regf-btn-danger" id="itemDeleteConfirmOk">Delete item</button>
        </div>
    </div>
</div>

<div class="regf-toast" id="itemToast" role="status" aria-live="polite" hidden></div>

<div class="registry-section">
    <div class="registry-toolbar" style="justify-content: flex-end;">
        <button type="button" class="btn-add-pill" id="addItemBtn">
            <svg class="btn-add-pill-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
            </svg>
            <span>Add Item</span>
        </button>
    </div>
    <div class="table-scroll">
<table class="data-table">
        <thead><tr>
            <th>Item</th><th>Category</th><th>Status</th><th>Registered On</th><th>Actions</th>
        </tr></thead>
        <tbody id="registryRows"></tbody>
    </table>
</div>
    <div class="table-empty" id="registryEmpty">No items registered yet.</div>
    <div class="pagination" id="registryPagination"></div>
</div>

<script>
    (function () {
        var nameInput = document.getElementById("itemName");
        var codeInput = document.getElementById("itemCode");
        var codeLabel = document.getElementById("itemCodeLabel");
        var categorySelect = document.getElementById("itemCategory");
        var categoryChips = document.getElementById("itemCategoryChips");
        var qtyInput = document.getElementById("itemQty");
        var qtyField = document.getElementById("itemQtyField");
        var clearBtn = document.getElementById("registerItemClearBtn");
        var submitBtn = document.getElementById("registerItemSubmitBtn");
        var formTitle = document.getElementById("itemFormTitle");
        var formMsg = document.getElementById("itemFormMsg");
        var form = document.getElementById("itemForm");

        // Same chip <-> hidden-select wiring as Register Student's
        // category/grade/gender chips - one radiogroup of pill buttons
        // that keeps a plain <select> in sync so the rest of the script
        // can keep reading/writing categorySelect.value exactly as before.
        function chipButtons(group) {
            return Array.prototype.slice.call(group.querySelectorAll(".regf-chip"));
        }

        function wireChips(group, select) {
            if (!group || !select) return;
            function pick(chip) {
                if (select.value !== chip.dataset.value) {
                    select.value = chip.dataset.value;
                    select.dispatchEvent(new Event("change", { bubbles: true }));
                }
                syncChips(group, select);
                chip.focus();
            }
            group.addEventListener("click", function (e) {
                var chip = e.target.closest(".regf-chip");
                if (chip) pick(chip);
            });
            group.addEventListener("keydown", function (e) {
                var step = (e.key === "ArrowRight" || e.key === "ArrowDown") ? 1
                    : (e.key === "ArrowLeft" || e.key === "ArrowUp") ? -1 : 0;
                if (!step) return;
                e.preventDefault();
                var chips = chipButtons(group);
                var at = chips.findIndex(function (c) { return c.dataset.value === select.value; });
                pick(chips[(at + step + chips.length) % chips.length]);
            });
        }

        function syncChips(group, select) {
            if (!group || !select) return;
            var chips = chipButtons(group);
            var anyChecked = chips.some(function (c) { return c.dataset.value === select.value; });
            chips.forEach(function (c, i) {
                var on = c.dataset.value === select.value;
                c.setAttribute("aria-checked", on ? "true" : "false");
                c.tabIndex = on || (!anyChecked && i === 0) ? 0 : -1;
            });
        }

        wireChips(categoryChips, categorySelect);
        syncChips(categoryChips, categorySelect);

        function showFormMessage(message, type) {
            if (!formMsg) return;
            if (!message) {
                formMsg.hidden = true;
                formMsg.textContent = "";
                return;
            }
            formMsg.textContent = message;
            formMsg.dataset.type = type || "info";
            formMsg.hidden = false;
        }

        // The register/edit form lives in a floating overlay - opened by
        // "Add Item" (blank form) or a row's Edit button (pre-filled),
        // closed by the X, clicking outside the card, or Esc. Same pattern
        // as Register Student's overlay.
        var overlay = document.getElementById("itemOverlay");
        var overlayCard = overlay ? overlay.querySelector(".regf-card") : null;
        var overlayClose = document.getElementById("itemOverlayClose");
        var addItemBtn = document.getElementById("addItemBtn");
        // Whatever button was clicked to open the form (Add Item, or a
        // row's Edit icon) - the shared-element morph grows the overlay
        // out of this element, and shrinks back into it on close (see
        // admin.js CLabTapMorph).
        var overlayTrigger = null;

        function showOverlay() {
            if (!overlay) return;
            overlay.style.display = "flex";
            setTimeout(function () { nameInput.focus(); }, 0);
        }

        function openOverlay(triggerEl) {
            overlayTrigger = triggerEl || null;
            if (overlayCard && overlayTrigger) {
                window.CLabTapMorph.open(overlayTrigger, overlayCard, showOverlay);
            } else {
                showOverlay();
            }
        }

        function hideOverlay() {
            if (overlay) overlay.style.display = "none";
        }

        function closeOverlay() {
            if (overlayCard && overlayTrigger) {
                window.CLabTapMorph.close(overlayTrigger, overlayCard, hideOverlay);
            } else {
                hideOverlay();
            }
            overlayTrigger = null;
        }

        var registryRows = document.getElementById("registryRows");
        var registryTable = registryRows.closest("table");
        var registryEmpty = document.getElementById("registryEmpty");
        var paginationEl = document.getElementById("registryPagination");
        var statTotalRegisteredEl = document.getElementById("statTotalRegistered");
        var statBorrowedEl = document.getElementById("statBorrowed");
        // Row count flexes with the actual screen (see chat: more rows on a
        // tall screen, fewer on a short one) instead of one fixed number -
        // still never lets the page itself scroll (admin.css "html, body
        // { overflow: hidden }"); CLabTapRowFit.watch below keeps this in
        // sync with the viewport.
        var PAGE_SIZE = 6;
        var currentPage = 1;
        var editingId = null;


        function escapeHtml(value) {
            return String(value == null ? "" : value).replace(/[&<>"']/g, function (ch) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch];
            });
        }

        [nameInput, codeInput, qtyInput].forEach(function (el) {
            el.addEventListener("input", function () {
                var field = el.closest(".regf-field");
                if (field) field.classList.remove("is-invalid");
            });
        });

        // Resets the form back to "register a new item" mode - used by
        // Clear/Cancel and after a successful save.
        function resetForm() {
            editingId = null;
            form.querySelectorAll("input, select").forEach(function (field) {
                if (field.tagName === "SELECT") {
                    field.selectedIndex = 0;
                } else {
                    field.value = "";
                }
            });
            form.querySelectorAll(".regf-field").forEach(function (f) {
                f.classList.remove("is-invalid");
            });
            syncChips(categoryChips, categorySelect);
            qtyField.hidden = false;
            codeLabel.textContent = "Item Code";
            formTitle.textContent = "Register Item";
            submitBtn.textContent = "Register Item";
            clearBtn.textContent = "Clear";
            showFormMessage("");
        }

        if (clearBtn && form) {
            clearBtn.addEventListener("click", function () {
                var wasEditing = !!editingId;
                resetForm();
                if (wasEditing) closeOverlay();
            });
        }

        if (addItemBtn) {
            addItemBtn.addEventListener("click", function () {
                resetForm();
                openOverlay(addItemBtn);
            });
        }

        // A save/update is already in flight once submitBtn is disabled
        // - closing now wouldn't cancel that request, it would just hide
        // the form while it's still unclear whether the item actually
        // got saved on a slow connection (see chat), so closing is
        // blocked outright until the response comes back.
        function overlayBusy() { return submitBtn && submitBtn.disabled; }

        if (overlayClose) {
            overlayClose.addEventListener("click", function () {
                if (overlayBusy()) return;
                resetForm();
                closeOverlay();
            });
        }

        if (overlay) {
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && overlay.style.display !== "none" && !overlayBusy()) {
                    resetForm();
                    closeOverlay();
                }
            });
        }

        var toastEl = document.getElementById("itemToast");
        var toastTimer = null;
        function setRegisterStatus(message, isError) {
            if (!toastEl) return;
            toastEl.textContent = message;
            toastEl.classList.toggle("is-error", !!isError);
            toastEl.hidden = false;
            toastEl.classList.remove("is-showing");
            void toastEl.offsetWidth;
            toastEl.classList.add("is-showing");
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function () {
                toastEl.classList.remove("is-showing");
                setTimeout(function () { toastEl.hidden = true; }, 200);
            }, 3200);
        }

        function statusTag(status) {
            if (!status) return "—";
            return escapeHtml(status);
        }

        // Builds one registry-table row - Edit + Delete (Delete is
        // disabled while the unit is out on loan, and hidden entirely
        // for Staff - see chat / RegisterItemController.IsAdmin - since
        // deleting an item record is Admin-only).
        function buildRegistryRow(item) {
            var row = document.createElement("tr");
            row.dataset.itemId = item.id;
            row.dataset.name = item.name || "";
            row.dataset.itemCode = item.itemCode || "";
            row.dataset.category = item.category || "";

            var isBorrowed = item.status === "Borrowed";
            var isAdmin = document.body.dataset.role === "Admin";
            var actionsHtml =
                '<button type="button" class="btn-icon btn-icon-edit registry-edit-btn" title="Edit" aria-label="Edit">' +
                    '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 20h4L19.5 8.5a2 2 0 0 0 0-2.8l-1.2-1.2a2 2 0 0 0-2.8 0L4 16v4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>' +
                '</button>' +
                (isAdmin
                    ? '<button type="button" class="btn-icon btn-icon-delete registry-delete-btn" title="Delete" aria-label="Delete" ' + (isBorrowed ? 'disabled' : '') + '>' +
                        '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
                            '<path d="M4 7h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>' +
                            '<path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
                            '<path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
                            '<path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>' +
                        '</svg>' +
                    '</button>'
                    : "");

            row.innerHTML =
                "<td>" + escapeHtml(item.name) + "</td>" +
                "<td>" + escapeHtml(item.category || "—") + "</td>" +
                "<td>" + statusTag(item.status) + "</td>" +
                "<td>" + escapeHtml(item.registeredOn) + "</td>" +
                '<td><div class="registry-actions">' + actionsHtml + '</div></td>';
            return row;
        }

        if (registryRows) {
            registryRows.addEventListener("click", function (e) {
                var editBtn = e.target.closest(".registry-edit-btn");
                if (editBtn) {
                    var editRow = editBtn.closest("tr");
                    if (!editRow) return;

                    editingId = editRow.dataset.itemId;
                    nameInput.value = editRow.dataset.name || "";
                    codeInput.value = editRow.dataset.itemCode || "";
                    categorySelect.value = editRow.dataset.category || "";
                    syncChips(categoryChips, categorySelect);
                    qtyInput.value = "";

                    qtyField.hidden = true;
                    codeLabel.textContent = "Item Code";
                    formTitle.textContent = "Edit Item";
                    submitBtn.textContent = "Save Changes";
                    clearBtn.textContent = "Cancel";
                    form.querySelectorAll(".regf-field").forEach(function (f) { f.classList.remove("is-invalid"); });
                    showFormMessage("");

                    openOverlay(editBtn);
                    return;
                }

                var deleteBtn = e.target.closest(".registry-delete-btn");
                if (!deleteBtn || deleteBtn.disabled) return;
                var row = deleteBtn.closest("tr");
                if (!row) return;

                openDeleteConfirm(row, row.dataset.name || "this item");
            });
        }

        // Custom delete-confirm dialog (same component Register Student
        // uses) instead of the browser's plain window.confirm.
        var deleteConfirmEl = document.getElementById("itemDeleteConfirm");
        var deleteConfirmText = document.getElementById("itemDeleteConfirmText");
        var deleteConfirmCancel = document.getElementById("itemDeleteConfirmCancel");
        var deleteConfirmOk = document.getElementById("itemDeleteConfirmOk");
        var deleteConfirmReturnFocus = null;
        var pendingDelete = null; // { row, name }

        function closeDeleteConfirm(returnFocus) {
            if (!deleteConfirmEl || deleteConfirmEl.hidden) return;
            deleteConfirmEl.hidden = true;
            deleteConfirmOk.disabled = false;
            deleteConfirmOk.textContent = "Delete item";
            if (returnFocus && deleteConfirmReturnFocus && deleteConfirmReturnFocus.focus) deleteConfirmReturnFocus.focus();
            deleteConfirmReturnFocus = null;
            pendingDelete = null;
        }

        function openDeleteConfirm(row, name) {
            if (!deleteConfirmEl) return;
            pendingDelete = { row: row, name: name };
            deleteConfirmText.textContent = "";
            deleteConfirmText.appendChild(document.createTextNode("This removes "));
            var strong = document.createElement("strong");
            strong.textContent = name;
            deleteConfirmText.appendChild(strong);
            deleteConfirmText.appendChild(document.createTextNode(" from this list. Borrow history, if any, is kept."));
            deleteConfirmReturnFocus = document.activeElement;
            deleteConfirmEl.hidden = false;
            deleteConfirmOk.focus();
        }

        function runPendingDelete() {
            if (!pendingDelete) return;
            var deleteRow = pendingDelete.row, name = pendingDelete.name;
            var deleteBtn = deleteRow.querySelector(".registry-delete-btn");
            deleteConfirmOk.disabled = true;
            deleteConfirmOk.textContent = "Deleting...";
            if (deleteBtn) deleteBtn.disabled = true;
            var body = new URLSearchParams();
            body.append("id", deleteRow.dataset.itemId);

            fetch("/RegisterItem/Delete", {
                method: "POST",
                headers: { "X-Requested-With": "XMLHttpRequest" },
                body: body
            })
                .then(function (response) {
                    return response.json().then(function (data) {
                        return { ok: response.ok, data: data };
                    });
                })
                .then(function (result) {
                    closeDeleteConfirm(false);
                    if (!result.ok) {
                        if (deleteBtn) deleteBtn.disabled = false;
                        setRegisterStatus(result.data.error || "Could not delete item.", true);
                        return;
                    }
                    if (editingId === deleteRow.dataset.itemId) {
                        resetForm();
                        closeOverlay();
                    }
                    setRegisterStatus(name + " deleted.", false);
                    loadRegistry();
                    loadStats();
                })
                .catch(function () {
                    closeDeleteConfirm(false);
                    if (deleteBtn) deleteBtn.disabled = false;
                    setRegisterStatus("Network error - could not reach the server.", true);
                });
        }

        if (deleteConfirmEl) {
            deleteConfirmCancel.addEventListener("click", function () { closeDeleteConfirm(true); });
            deleteConfirmOk.addEventListener("click", runPendingDelete);
            deleteConfirmEl.addEventListener("click", function (e) {
                if (e.target === deleteConfirmEl) closeDeleteConfirm(true);
            });
            deleteConfirmEl.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { closeDeleteConfirm(true); return; }
                if (e.key !== "Tab") return;
                var first = deleteConfirmCancel, last = deleteConfirmOk;
                if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
                else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            });
        }

        function goToPage(page) {
            currentPage = page;
            loadRegistry();
        }

        // Loads the registered items from the server (paginated +
        // filtered), so the table survives navigating away and back.
        function loadRegistry() {
            var params = new URLSearchParams();
            params.append("page", currentPage);
            params.append("pageSize", PAGE_SIZE);

            var searchInput = document.getElementById("itemFilterSearch");
            if (searchInput && searchInput.value.trim()) params.append("search", searchInput.value.trim());

            var categoryFilter = document.getElementById("itemFilterCategory");
            if (categoryFilter && categoryFilter.dataset.value && categoryFilter.dataset.value !== "All") {
                params.append("category", categoryFilter.dataset.value);
            }
            var statusFilter = document.getElementById("itemFilterStatus");
            if (statusFilter && statusFilter.dataset.value && statusFilter.dataset.value !== "All") {
                params.append("status", statusFilter.dataset.value);
            }
            var dateStart = document.getElementById("itemFilterDateStart");
            if (dateStart && dateStart.value) params.append("dateStart", dateStart.value);
            var dateEnd = document.getElementById("itemFilterDateEnd");
            if (dateEnd && dateEnd.value) params.append("dateEnd", dateEnd.value);

            var productFilter = document.getElementById("itemFilterProduct");
            if (productFilter && productFilter.value) params.append("product", productFilter.value);

            fetch("/RegisterItem/List?" + params.toString(), { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    currentPage = data.page || 1;
                    var items = data.rows || [];
                    registryRows.innerHTML = "";
                    if (items.length === 0) {
                        registryEmpty.style.display = "";
                        registryEmpty.textContent = "No items registered yet.";
                    } else {
                        registryEmpty.style.display = "none";
                        items.forEach(function (item) {
                            registryRows.appendChild(buildRegistryRow(item));
                        });
                        window.CLabTapStagger.apply(registryRows.children);
                    }
                    window.CLabTapPagination.render(paginationEl, data, goToPage);
                    if (fbar) fbar.refresh();
                    // Real rows are now in the tbody - recheck against
                    // their genuine height, not the throwaway probe row
                    // CLabTapRowFit had to measure before any data had
                    // loaded.
                    if (rowFitController) rowFitController.recheck();
                })
                .catch(function () {
                    // Leave whatever is already in the table; a failed
                    // refresh shouldn't wipe out what's showing.
                });
        }

        // Independent of the table's own filters - always "how many active
        // units exist right now" / "how many of those are out on loan"
        // (see RegisterItemController.Stats).
        function loadStats() {
            fetch("/RegisterItem/Stats", { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (statTotalRegisteredEl) statTotalRegisteredEl.textContent = data.totalRegistered;
                    if (statBorrowedEl) statBorrowedEl.textContent = data.borrowed;
                })
                .catch(function () {
                    // Stat cards just stay at "—" if this fails.
                });
        }

        if (submitBtn) {
            submitBtn.addEventListener("click", function () {
                var name = nameInput.value.trim();
                var code = codeInput.value.trim();
                form.querySelectorAll(".regf-field").forEach(function (f) { f.classList.remove("is-invalid"); });
                if (!name || !code) {
                    if (!name) nameInput.closest(".regf-field").classList.add("is-invalid");
                    if (!code) codeInput.closest(".regf-field").classList.add("is-invalid");
                    showFormMessage("Item name and item code are required.", "error");
                    return;
                }
                showFormMessage("");

                var category = categorySelect.value;
                submitBtn.disabled = true;
                submitBtn.classList.add("is-loading");

                if (editingId) {
                    setRegisterStatus("Saving...", false);
                    var updateBody = new URLSearchParams();
                    updateBody.append("Id", editingId);
                    updateBody.append("Name", name);
                    updateBody.append("ItemCodeBase", code);
                    if (category) updateBody.append("Category", category);

                    fetch("/RegisterItem/Update", {
                        method: "POST",
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                        body: updateBody
                    })
                        .then(function (response) {
                            return response.json().then(function (data) {
                                return { ok: response.ok, data: data };
                            });
                        })
                        .then(function (result) {
                            submitBtn.disabled = false;
                            submitBtn.classList.remove("is-loading");
                            if (!result.ok) {
                                setRegisterStatus(result.data.error || "Could not update item.", true);
                                return;
                            }
                            setRegisterStatus(name + " updated.", false);
                            resetForm();
                            closeOverlay();
                            loadRegistry();
                        })
                        .catch(function () {
                            submitBtn.disabled = false;
                            submitBtn.classList.remove("is-loading");
                            setRegisterStatus("Network error - could not reach the server.", true);
                        });
                    return;
                }

                var qty = parseInt(qtyInput.value, 10) || 1;
                setRegisterStatus("Registering...", false);

                var body = new URLSearchParams();
                body.append("Name", name);
                body.append("ItemCodeBase", code);
                body.append("Quantity", qty);
                if (category) body.append("Category", category);

                fetch("/RegisterItem/Create", {
                    method: "POST",
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    body: body
                })
                    .then(function (response) {
                        return response.json().then(function (data) {
                            return { ok: response.ok, data: data };
                        });
                    })
                    .then(function (result) {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove("is-loading");
                        if (!result.ok) {
                            setRegisterStatus(result.data.error || "Could not register item.", true);
                            return;
                        }

                        var codes = result.data.codes || [];
                        setRegisterStatus(codes.length + " unit(s) registered: " + codes.join(", "), false);
                        resetForm();
                        closeOverlay();
                        currentPage = 1;
                        loadRegistry();
                        loadStats();
                    })
                    .catch(function () {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove("is-loading");
                        setRegisterStatus("Network error - could not reach the server.", true);
                    });
            });
        }

        // "Filters" popover + chips for whatever is applied (shared
        // component, see admin.js CLabTapFilterBar).
        var fbar = null;
        function initItemFilterBar() {
            if (fbar || !window.CLabTapFilterBar) return;
            var FB = window.CLabTapFilterBar;
            var categoryGroup = document.getElementById("itemFilterCategory");
            var statusGroup = document.getElementById("itemFilterStatus");
            var dateStartEl = document.getElementById("itemFilterDateStart");
            var dateEndEl = document.getElementById("itemFilterDateEnd");
            var productEl = document.getElementById("itemFilterProduct");

            fbar = FB.init({
                moreBtn: document.getElementById("itemFbarMore"),
                panel: document.getElementById("itemFbarPanel"),
                chipsEl: document.getElementById("itemFbarChips"),
                badge: document.getElementById("itemFbarBadge"),
                onApply: function () { document.getElementById("itemFilterApply").click(); },
                onClearAll: function () { document.getElementById("itemFilterClear").click(); },
                onChange: function () { currentPage = 1; loadRegistry(); },
                controls: [
                    FB.fromGroup(categoryGroup, "Category", false),
                    FB.fromGroup(statusGroup, "Status", false),
                    FB.fromDate(dateStartEl, "From", true),
                    FB.fromDate(dateEndEl, "To", true),
                    FB.fromSelect(productEl, "Product", true)
                ]
            });
            fbar.refresh();
        }

        function initFilters() {
            var categoryGroup = document.getElementById("itemFilterCategory");
            var statusGroup = document.getElementById("itemFilterStatus");
            if (window.CLabTapToggleGroup) {
                window.CLabTapToggleGroup.init(categoryGroup);
                window.CLabTapToggleGroup.init(statusGroup);
            }

            var searchInput = document.getElementById("itemFilterSearch");
            var applyBtn = document.getElementById("itemFilterApply");
            var clearFiltersBtn = document.getElementById("itemFilterClear");

            var searchDebounce = null;
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    clearTimeout(searchDebounce);
                    searchDebounce = setTimeout(function () { currentPage = 1; loadRegistry(); }, 300);
                });
            }
            if (applyBtn) {
                applyBtn.addEventListener("click", function () { currentPage = 1; loadRegistry(); });
            }
            if (clearFiltersBtn) {
                clearFiltersBtn.addEventListener("click", function () {
                    if (searchInput) searchInput.value = "";
                    if (window.CLabTapToggleGroup) {
                        window.CLabTapToggleGroup.reset(categoryGroup);
                        window.CLabTapToggleGroup.reset(statusGroup);
                    }
                    ["itemFilterDateStart", "itemFilterDateEnd"].forEach(function (id) {
                        var el = document.getElementById(id);
                        if (el) el.value = "";
                    });
                    var productFilter = document.getElementById("itemFilterProduct");
                    if (productFilter) productFilter.value = "";
                    currentPage = 1;
                    loadRegistry();
                });
            }
            initItemFilterBar();
            loadProductFilterOptions();
        }

        // Fills the Product dropdown with every distinct item name
        // that's actually been registered, same pattern Attendance/
        // Register Student use for their Section filter.
        function loadProductFilterOptions() {
            var productEl = document.getElementById("itemFilterProduct");
            if (!productEl) return;
            fetch("/RegisterItem/FilterOptions", { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    var products = (data && data.products) || [];
                    products.forEach(function (name) {
                        var opt = document.createElement("option");
                        opt.value = name;
                        opt.textContent = name;
                        productEl.appendChild(opt);
                    });
                })
                .catch(function () {
                    // Product filter just stays at "All" if this fails.
                });
        }

        loadStats();

        // On a direct/hard page load this inline script runs before
        // admin.js (further down the page) has executed, so
        // window.CLabTapRowFit/ToggleGroup/FilterBar don't exist yet at
        // this exact point - deferring to DOMContentLoaded (same pattern
        // used elsewhere on this page's siblings) fixes that; the AJAX
        // nav-swap case (document already "complete") still runs
        // immediately.
        var rowFitController = null;
        function initRowFit() {
            initFilters();
            if (window.CLabTapRowFit) {
                rowFitController = window.CLabTapRowFit.watch(registryTable, { minRows: 3, fallbackRows: 6 }, function (rows) {
                    PAGE_SIZE = rows;
                    currentPage = 1;
                    loadRegistry();
                });
            } else {
                loadRegistry();
            }
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initRowFit);
        } else {
            initRowFit();
        }
    })();
</script>
